rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'tarotistasonline@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Validation helper for aggregate VisitorStats (no PII)
    function isValidVisitorStats(data) {
      return data.keys().hasAll(['totalVisits', 'todayVisits', 'uniqueVisitors', 'lastDate', 'updatedAt'])
        && data.keys().hasOnly(['totalVisits', 'todayVisits', 'uniqueVisitors', 'lastDate', 'updatedAt'])
        && data.totalVisits is int
        && data.totalVisits >= 39
        && data.totalVisits <= 100000000
        && data.todayVisits is int
        && data.todayVisits >= 1
        && data.todayVisits <= 10000000
        && data.uniqueVisitors is int
        && data.uniqueVisitors >= 25
        && data.uniqueVisitors <= 100000000
        && data.lastDate is string
        && data.lastDate.size() == 10
        && data.lastDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.updatedAt is timestamp;
    }

    // Public non-PII aggregate counter document at /stats/visitors
    match /stats/{statId} {
      allow get: if isValidId(statId) && statId == 'visitors';
      allow list: if isAdmin();

      // Allow initial seed creation only at the baseline range
      allow create: if isValidId(statId)
        && statId == 'visitors'
        && isValidVisitorStats(incoming())
        && incoming().updatedAt == request.time
        && incoming().totalVisits >= 39
        && incoming().totalVisits <= 50
        && incoming().todayVisits >= 1
        && incoming().todayVisits <= 10
        && incoming().uniqueVisitors >= 25
        && incoming().uniqueVisitors <= 35;

      // Allow monotonic +1 increment updates or admin overrides
      allow update: if isValidId(statId)
        && statId == 'visitors'
        && isValidVisitorStats(incoming())
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['totalVisits', 'todayVisits', 'uniqueVisitors', 'lastDate', 'updatedAt'])
            && existing().totalVisits is int
            && existing().uniqueVisitors is int
            && incoming().totalVisits == existing().totalVisits + 1
            && (
              incoming().uniqueVisitors == existing().uniqueVisitors
              || incoming().uniqueVisitors == existing().uniqueVisitors + 1
            )
            && (
              !('lastDate' in existing())
              || (
                existing().lastDate == incoming().lastDate
                && existing().todayVisits is int
                && incoming().todayVisits == existing().todayVisits + 1
              )
              || (
                existing().lastDate != incoming().lastDate
                && incoming().todayVisits == 1
              )
            )
          )
        );

      allow delete: if isValidId(statId) && isAdmin();
    }
  }
}
