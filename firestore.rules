rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for VisitorStats (Anti-Update-Gap)
    function isValidVisitorStats(data) {
      return data.keys().hasAll(['totalVisits', 'todayVisits', 'uniqueVisitors', 'today', 'updatedAt'])
        && data.keys().hasOnly(['totalVisits', 'todayVisits', 'uniqueVisitors', 'today', 'updatedAt'])
        && data.totalVisits is int
        && data.totalVisits >= 1
        && data.totalVisits <= 100000000
        && data.todayVisits is int
        && data.todayVisits >= 1
        && data.todayVisits <= data.totalVisits
        && data.uniqueVisitors is int
        && data.uniqueVisitors >= 1
        && data.uniqueVisitors <= data.totalVisits
        && data.today is string
        && data.today.size() == 10
        && data.today.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidInitialVisitorStats(data) {
      return data.totalVisits >= 38
        && data.totalVisits <= 200
        && data.todayVisits >= 1
        && data.todayVisits <= 200
        && data.uniqueVisitors >= 24
        && data.uniqueVisitors <= 200;
    }

    function isIncrementAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['totalVisits', 'todayVisits', 'uniqueVisitors', 'today', 'updatedAt'])
        && incoming().totalVisits == existing().totalVisits + 1
        && incoming().uniqueVisitors >= existing().uniqueVisitors
        && incoming().uniqueVisitors <= existing().uniqueVisitors + 1
        && (
          (incoming().today == existing().today && incoming().todayVisits == existing().todayVisits + 1)
          || (incoming().today != existing().today && incoming().todayVisits == 1)
        );
    }

    match /stats/{statsId} {
      allow get: if isValidId(statsId) && statsId == 'global';
      allow list: if false;
      allow create: if isValidId(statsId)
        && statsId == 'global'
        && isValidVisitorStats(incoming())
        && isValidInitialVisitorStats(incoming());
      allow update: if isValidId(statsId)
        && statsId == 'global'
        && isValidVisitorStats(incoming())
        && isIncrementAction();
      allow delete: if false;
    }
  }
}
