{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://ais-pre-fn5tz4dobb6so5ytrfrpwr-172786148761.us-east1.run.app/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
